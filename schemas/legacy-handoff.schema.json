{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnolith.dev/schemas/alembic/legacy-handoff-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "projectRoot", "configDigest", "legacyMarkerDigest", "marker", "connection", "receipts", "sha256"],
  "properties": {
    "format": { "const": "gnolith-setup-to-alembic-v1" },
    "schemaVersion": { "const": 1 },
    "projectRoot": { "type": "string" },
    "configDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "legacyMarkerDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "marker": { "type": "object" },
    "connection": { "type": ["object", "null"] },
    "receipts": { "type": "array", "maxItems": 1000 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
