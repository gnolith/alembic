{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "license", "mcpServers", "skills", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "alembic" },
    "name": { "const": "Alembic" },
    "version": { "const": "0.1.0" },
    "description": { "type": "string" },
    "license": { "const": "MIT" },
    "mcpServers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alembic"],
      "properties": {
        "alembic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "args", "cwd", "transport"],
          "properties": {
            "command": { "const": "node" },
            "args": { "const": ["${pluginRoot}/dist/mcp.js"] },
            "cwd": { "const": "${projectRoot}" },
            "transport": { "const": "stdio" }
          }
        }
      }
    },
    "skills": { "const": ["${pluginRoot}/skills/alembic/SKILL.md"] },
    "capabilities": { "type": "object" }
  }
}
